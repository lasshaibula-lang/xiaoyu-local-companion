# Copy to .env. Demo mode works without an API key.
COMPANION_MODE=demo
COMPANION_PROVIDER=qwen
# Copy the compatible API base URL shown in your provider console.
COMPANION_BASE_URL=
COMPANION_MODEL=qwen-plus-character
COMPANION_SUMMARY_MODEL=qwen-flash
COMPANION_API_KEY=
COMPANION_EMBEDDING_MODEL=text-embedding-v4
COMPANION_EMBEDDING_ENABLED=false
COMPANION_MONTHLY_BUDGET=50
# All runtime data stays here; defaults to ./data when omitted.
# COMPANION_DATA_DIR=./data
